<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- JitPack multi-module convention: consumers resolve each module as
         com.github.<user>.<repo>:<module>:<version>, so the groupId here must be
         com.github.Edward-Hanson.audit-sdk for inter-module (and consumer) resolution to work. -->
    <groupId>com.github.Edward-Hanson.audit-sdk</groupId>
    <artifactId>audit-sdk-parent</artifactId>
    <version>0.8.0</version>
    <packaging>pom</packaging>

    <name>Audit SDK (parent)</name>
    <description>Publishes validated audit events to Kafka. One framework-neutral core plus a thin
        Spring Boot starter per Boot generation (3.x and 4.x).</description>
    <url>https://github.com/Edward-Hanson/audit-sdk</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/Edward-Hanson/audit-sdk</url>
        <connection>scm:git:https://github.com/Edward-Hanson/audit-sdk.git</connection>
        <developerConnection>scm:git:https://github.com/Edward-Hanson/audit-sdk.git</developerConnection>
    </scm>

    <modules>
        <module>audit-sdk-core</module>
        <module>audit-sdk-spring-boot-3</module>
        <module>audit-sdk-spring-boot-4</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>

        <!-- Libraries shared by every module (framework-neutral). -->
        <kafka-clients.version>3.7.0</kafka-clients.version>
        <jackson.version>2.17.1</jackson.version>
        <jakarta-validation.version>3.0.2</jakarta-validation.version>
        <slf4j.version>2.0.13</slf4j.version>

        <!-- Test libs (kept independent of any Boot BOM so core stays Spring-free). -->
        <junit.version>5.10.2</junit.version>
        <assertj.version>3.25.3</assertj.version>
        <mockito.version>5.11.0</mockito.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.3.1</version>
                    <executions>
                        <execution>
                            <id>attach-sources</id>
                            <goals>
                                <goal>jar-no-fork</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.7.0</version>
                    <configuration>
                        <doclint>none</doclint>
                        <quiet>true</quiet>
                    </configuration>
                    <executions>
                        <execution>
                            <id>attach-javadocs</id>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
